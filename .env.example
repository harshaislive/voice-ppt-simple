# Azure OpenAI Configuration
# Required for AI narration and question classification
# If not configured, system will use mock implementations
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4

# Azure Realtime Voice Configuration (recommended for browser mic + live speech)
# If omitted, browser falls back to local speech recognition for interruptions.
AZURE_OPENAI_REALTIME_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_REALTIME_API_KEY=your-api-key-here
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_REALTIME_VOICE=alloy

# TTS Configuration
# TTS_PROVIDER: azure-realtime (gpt-realtime-mini via WebSocket), azure-speech (tts-1/tts-1-hd via REST), kittentts
# Auto-detected: uses azure-realtime if Azure OpenAI creds are set, otherwise kittentts if KITTENTTS_URL is set
TTS_PROVIDER=azure-realtime
AZURE_OPENAI_TTS_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_OPENAI_TTS_API_KEY=your-tts-api-key-here
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_TTS_VOICE=alloy

# KittenTTS Configuration (legacy, only used if TTS_PROVIDER=kittentts)
KITTENTTS_URL=http://localhost:8080/tts

# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_API_KEY=change-this-before-production

# Database
# Path to SQLite database file
DB_PATH=./voice-ppt.db

# Supabase CMS
# When configured, presentation metadata, slides, docs, and assets can be loaded from Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SCHEMA=public
CMS_REMOTE_REQUIRED=false
