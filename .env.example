PORT=3000
HOST=0.0.0.0
NODE_ENV=production
ALLOWED_ORIGINS=https://your-coolify-domain.com,http://localhost:3000
ADMIN_API_KEY=your-admin-key
DB_PATH=./data/voice-ppt.db
DEFAULT_PASSCODE=

# Azure OpenAI / Foundry chat
# Use either the classic Azure OpenAI pair or the Foundry aliases.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_VOICELIVE_ENDPOINT=
AZURE_VOICELIVE_API_KEY=
AZURE_EXISTING_AIPROJECT_ENDPOINT=
AZURE_CHAT_DEPLOYMENT=

# Azure realtime voice fallback
AZURE_OPENAI_REALTIME_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_REALTIME_API_KEY=your-azure-realtime-api-key
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_REALTIME_VOICE=alloy

# TTS provider
# Recommended for phrase reel timing and word-boundary events:
# TTS_PROVIDER=azure-sdk
TTS_PROVIDER=azure-sdk
AZURE_OPENAI_TTS_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_OPENAI_TTS_API_KEY=your-azure-tts-api-key
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_TTS_VOICE=alloy

# Azure Speech SDK timing
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

# Legacy fallback
KITTENTTS_URL=http://localhost:8080/tts

# Supabase CMS
CMS_REMOTE_REQUIRED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SCHEMA=public

# Optional only if you seed or use client-side auth flows elsewhere.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Coolify notes
# - Use the repo Dockerfile, not Nixpacks
# - Mount persistent storage at /app/data
# - Health check: GET /api/health
